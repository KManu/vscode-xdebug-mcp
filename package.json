{
  "name": "vscode-xdebug-mcp",
  "displayName": "Xdebug MCP",
  "publisher": "KwabenaManu",
  "version": "0.1.0",
  "description": "Expose Xdebug controls to MCP-aware VS Code agents for improved PHP debugging.",
  "icon": "images/vscode_xdebug_mcp_icon.png",
  "pricing": "Free",
  "preview": true,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "check-types": "tsc --noEmit --project tsconfig.json",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production",
    "vsce:package": "npm run package && npx vsce package",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "verify:mock-dap": "node scripts/verify-mock-dap.js",
    "test:integration": "npm run compile:integration && npm run compile && npm run verify:mock-dap && vscode-test",
    "test:all": "npm run compile && npm run compile:integration && npm run verify:mock-dap && npm run test && vscode-test"
  },
  "keywords": [
    "xdebug",
    "mcp",
    "debug"
  ],
  "categories": [
    "Other",
    "Debuggers"
  ],
  "author": "Kwabena Manu",
  "repository": {
    "type": "git",
    "url": "https://github.com/KManu/vscode-xdebug-mcp.git"
  },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "xdebugMcpProvider",
        "label": "Xdebug MCP Provider"
      }
    ],
    "debuggers": [
      {
        "type": "xdebug-mcp-test",
        "label": "Xdebug MCP Test Adapter"
      }
    ],
    "commands": [
      {
        "command": "xdebug-mcp.copyUri",
        "title": "Xdebug MCP: Copy Server URI to Clipboard"
      },
      {
        "command": "xdebug-mcp.showDiagnostics",
        "title": "Xdebug MCP: Show Diagnostics"
      },
      {
        "command": "xdebug-mcp.copyConfig",
        "title": "Xdebug MCP: Copy MCP Client Config Snippet"
      },
      {
        "command": "xdebug-mcp.addToWorkspaceMcp",
        "title": "Xdebug MCP: Add to Workspace .vscode/mcp.json"
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "vsce": "^2.15.0"
  }
}
